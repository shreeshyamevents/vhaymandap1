{% extends "base.html" %}

{% block title %}Vendor Dashboard - VyahMandap{% endblock %}

{% block content %}
<div class="flex justify-between items-center mb-6 flex-wrap gap-3">
    <div>
        <h2 class="text-2xl font-bold">🏪 Vendor Dashboard</h2>
        <p class="text-sm text-gray-500">Welcome, {{ current_user.name }}!</p>
    </div>
    <div class="flex gap-2 flex-wrap">
        <a href="{{ url_for('vendor_calendar') }}" class="bg-blue-700 text-white text-xs font-bold px-4 py-2 rounded-lg hover:bg-blue-600">
            <i class="fa-regular fa-calendar mr-1"></i>Booking Calendar
        </a>
        <a href="{{ url_for('vendor_add_item') }}" class="bg-green-700 text-white text-xs font-bold px-4 py-2 rounded-lg hover:bg-green-600">
            <i class="fa-regular fa-plus mr-1"></i>Add New Item
        </a>
    </div>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
    <div class="bg-white p-4 rounded-xl border shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-xs text-gray-500">Total Items</span>
            <i class="fa-solid fa-box text-green-700"></i>
        </div>
        <h3 class="text-2xl font-bold mt-1">{{ total_items }}</h3>
    </div>
    <div class="bg-white p-4 rounded-xl border shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-xs text-gray-500">Total Bookings</span>
            <i class="fa-solid fa-calendar-check text-blue-700"></i>
        </div>
        <h3 class="text-2xl font-bold mt-1">{{ total_bookings }}</h3>
    </div>
    <div class="bg-white p-4 rounded-xl border shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-xs text-gray-500">Active Rentals</span>
            <i class="fa-solid fa-clock text-orange-600"></i>
        </div>
        <h3 class="text-2xl font-bold mt-1 text-orange-600">{{ active_rentals }}</h3>
    </div>
    <div class="bg-white p-4 rounded-xl border shadow-sm">
        <div class="flex items-center justify-between">
            <span class="text-xs text-gray-500">Total Earnings</span>
            <i class="fa-solid fa-indian-rupee-sign text-green-700"></i>
        </div>
        <h3 class="text-2xl font-bold mt-1 text-green-700">{{ format_currency(total_earnings) }}</h3>
    </div>
</div>

<!-- Upcoming Bookings -->
{% if upcoming_bookings %}
<div class="bg-white p-6 rounded-xl border shadow-sm mb-8">
    <div class="flex justify-between items-center mb-4">
        <h4 class="font-bold">📅 Upcoming Bookings (Next 30 Days)</h4>
        <a href="{{ url_for('vendor_calendar') }}" class="text-xs text-green-700 font-bold hover:underline">View Calendar →</a>
    </div>
    <div class="space-y-3">
        {% for booking in upcoming_bookings[:5] %}
        <div class="flex flex-wrap justify-between items-center p-3 bg-gray-50 rounded-lg gap-2">
            <div class="flex-1 min-w-[200px]">
                <p class="font-bold text-sm">{{ booking.item.title }}</p>
                <p class="text-xs text-gray-500">
                    <i class="fa-regular fa-user mr-1"></i>{{ booking.customer.name }}
                    <span class="mx-2">•</span>
                    <i class="fa-regular fa-box mr-1"></i>Qty: {{ booking.quantity }}
                </p>
            </div>
            <div class="text-xs">
                <span class="bg-green-100 text-green-800 px-2 py-0.5 rounded-full font-bold">
                    {{ booking.start_date.strftime('%d %b') }} → {{ booking.end_date.strftime('%d %b') }}
                </span>
            </div>
            <div class="text-xs font-bold text-green-700">
                {{ format_currency(booking.base_rent) }}
            </div>
        </div>
        {% endfor %}
    </div>
</div>
{% endif %}

<!-- My Items -->
<div class="bg-white p-6 rounded-xl border shadow-sm mb-8">
    <div class="flex justify-between items-center mb-4">
        <h4 class="font-bold">📦 My Listed Items</h4>
        <a href="{{ url_for('vendor_add_item') }}" class="text-xs bg-green-700 text-white font-bold px-3 py-1.5 rounded-lg hover:bg-green-600">
            <i class="fa-regular fa-plus mr-1"></i>Add Item
        </a>
    </div>
    
    {% if items %}
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-gray-50">
                <tr>
                    <th class="p-3">Image</th>
                    <th class="p-3">Title</th>
                    <th class="p-3">Category</th>
                    <th class="p-3">Rate/Day</th>
                    <th class="p-3">Stock</th>
                    <th class="p-3">Status</th>
                    <th class="p-3">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                <tr class="border-b hover:bg-gray-50">
                    <td class="p-3">
                        <div class="w-12 h-12 bg-gray-100 rounded overflow-hidden">
                            <img src="{{ item.get_image() }}" class="w-full h-full object-cover" alt="{{ item.title }}" onerror="this.src='/static/images/default-item.jpg'">
                        </div>
                    </td>
                    <td class="p-3 font-medium">{{ item.title }}</td>
                    <td class="p-3 text-xs">{{ item.category|title }}</td>
                    <td class="p-3 font-bold text-green-700">₹{{ item.rate_per_day }}</td>
                    <td class="p-3">{{ item.stock }}</td>
                    <td class="p-3">
                        <span class="text-xs px-2 py-0.5 rounded-full {% if item.is_available %}bg-green-100 text-green-800{% else %}bg-red-100 text-red-800{% endif %}">
                            {{ 'Available' if item.is_available else 'Unavailable' }}
                        </span>
                    </td>
                    <td class="p-3 flex gap-2">
                        <a href="{{ url_for('vendor_edit_item', item_id=item.id) }}" class="text-blue-600 hover:text-blue-800 text-xs font-bold">Edit</a>
                        <form method="POST" action="{{ url_for('vendor_delete_item', item_id=item.id) }}" onsubmit="return confirm('Delete this item?')" class="inline">
                            <button type="submit" class="text-red-600 hover:text-red-800 text-xs font-bold">Delete</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <div class="text-center py-8 text-gray-500">
        <i class="fa-regular fa-box text-4xl text-gray-300 mb-2 block"></i>
        <p class="text-sm">You haven't listed any items yet.</p>
        <a href="{{ url_for('vendor_add_item') }}" class="text-green-700 font-bold hover:underline text-sm">Add your first item →</a>
    </div>
    {% endif %}
</div>

<!-- Recent Bookings -->
<div class="bg-white p-6 rounded-xl border shadow-sm">
    <h4 class="font-bold mb-4">📋 Recent Bookings</h4>
    
    {% if bookings %}
    <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
            <thead class="bg-gray-50">
                <tr>
                    <th class="p-2">Ref</th>
                    <th class="p-2">Customer</th>
                    <th class="p-2">Item</th>
                    <th class="p-2">Dates</th>
                    <th class="p-2">Qty</th>
                    <th class="p-2">Earnings</th>
                    <th class="p-2">Status</th>
                </tr>
            </thead>
            <tbody>
                {% for booking in bookings %}
                <tr class="border-b hover:bg-gray-50">
                    <td class="p-2 font-mono text-xs">{{ booking.booking_reference }}</td>
                    <td class="p-2">
                        {{ booking.customer.name }}
                        <div class="text-[10px] text-gray-500">{{ booking.customer.mobile }}</div>
                    </td>
                    <td class="p-2">{{ booking.item.title[:20] }}{% if booking.item.title|length > 20 %}...{% endif %}</td>
                    <td class="p-2 text-xs">{{ booking.start_date }} → {{ booking.end_date }}</td>
                    <td class="p-2">{{ booking.quantity }}</td>
                    <td class="p-2 font-bold text-green-700">₹{{ booking.base_rent }}</td>
                    <td class="p-2">
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold
                            {% if booking.booking_status == 'confirmed' %}bg-green-100 text-green-800
                            {% elif booking.booking_status == 'cancelled' %}bg-red-100 text-red-800
                            {% elif booking.booking_status == 'completed' %}bg-blue-100 text-blue-800
                            {% else %}bg-gray-100 text-gray-800{% endif %}">
                            {{ booking.booking_status|title }}
                        </span>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
    {% else %}
    <p class="text-gray-500 text-sm text-center py-4">No bookings yet.</p>
    {% endif %}
</div>
{% endblock %}