@app.route('/api/vendor/calendar')
@login_required
def api_vendor_calendar():
    if current_user.role not in ['admin', 'vendor']:
        return jsonify([])
    
    items = Item.query.filter_by(vendor_id=current_user.id).all()
    item_ids = [i.id for i in items]
    
    bookings = Booking.query.filter(Booking.item_id.in_(item_ids)).all()
    
    events = []
    for b in bookings:
        events.append({
            'id': b.id,
            'title': f"{b.item.title} - {b.customer.name}",
            'start': b.start_date.isoformat(),
            'end': b.end_date.isoformat(),
            'color': '#2d5a3d' if b.booking_status == 'confirmed' else '#b91c1c',
            'extendedProps': {
                'customer': b.customer.name,
                'item': b.item.title,
                'quantity': b.quantity,
                'total': b.total_amount,
                'status': b.booking_status,
                'venue': b.venue_address,
                'utr': b.utr_number
            }
        })
    
    return jsonify(events)

