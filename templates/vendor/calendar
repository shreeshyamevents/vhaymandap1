{% extends "base.html" %}

{% block title %}Booking Calendar - VyahMandap{% endblock %}

{% block extra_head %}
<!-- FullCalendar CDN -->
<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.10/index.global.min.js'></script>
<style>
    #calendar {
        background: white;
        border-radius: 12px;
        padding: 20px;
        border: 1px solid #e5e7eb;
    }
    .fc-event {
        cursor: pointer;
        border-radius: 4px;
        padding: 2px 4px;
        font-size: 11px;
        font-weight: 600;
    }
    .fc-toolbar-title {
        font-size: 1.1rem !important;
        font-weight: 700;
    }
    .fc-button {
        background: #2d5a3d !important;
        border-color: #2d5a3d !important;
        font-size: 12px !important;
        text-transform: capitalize;
    }
    .fc-button:hover {
        background: #1e3e2a !important;
    }
    .fc-button-active {
        background: #1e3e2a !important;
    }
    .booking-detail {
        padding: 8px 0;
        border-bottom: 1px solid #f0f0f0;
    }
    .booking-detail:last-child {
        border-bottom: none;
    }
</style>
{% endblock %}

{% block content %}
<div class="flex justify-between items-center mb-6 flex-wrap gap-3">
    <div>
        <h2 class="text-2xl font-bold">📅 Booking Calendar</h2>
        <p class="text-sm text-gray-500">View all your bookings at a glance</p>
    </div>
    <div class="flex gap-2 flex-wrap">
        <a href="{{ url_for('vendor_dashboard') }}" class="bg-gray-700 text-white text-xs font-bold px-4 py-2 rounded-lg hover:bg-gray-600">
            ← Back to Dashboard
        </a>
        <a href="{{ url_for('vendor_add_item') }}" class="bg-green-700 text-white text-xs font-bold px-4 py-2 rounded-lg hover:bg-green-600">
            <i class="fa-regular fa-plus mr-1"></i>Add Item
        </a>
    </div>
</div>

<!-- Filters -->
<div class="bg-white p-4 rounded-xl border shadow-sm mb-6">
    <div class="flex flex-wrap gap-4 items-end">
        <div class="flex-1 min-w-[200px]">
            <label class="block font-semibold text-xs mb-1">Filter by Item</label>
            <select id="itemFilter" class="w-full border rounded-lg p-2.5 text-sm bg-white" onchange="filterCalendar()">
                <option value="all">All Items</option>
                {% for item in items %}
                    <option value="{{ item.id }}">{{ item.title }}</option>
                {% endfor %}
            </select>
        </div>
        <div>
            <label class="block font-semibold text-xs mb-1">View</label>
            <select id="viewSelect" class="border rounded-lg p-2.5 text-sm bg-white" onchange="changeView()">
                <option value="dayGridMonth">Month</option>
                <option value="dayGridWeek">Week</option>
                <option value="listMonth">List</option>
            </select>
        </div>
        <button onclick="refreshCalendar()" class="bg-blue-700 text-white text-xs font-bold px-4 py-2.5 rounded-lg hover:bg-blue-600">
            <i class="fa-solid fa-rotate mr-1"></i>Refresh
        </button>
    </div>
    
    <!-- Legend -->
    <div class="mt-3 pt-3 border-t flex flex-wrap gap-3 text-xs">
        <span class="font-semibold text-gray-700">Legend:</span>
        {% for item in items %}
        <span class="flex items-center gap-1">
            <span class="w-3 h-3 rounded-full" style="background: {{ ['#2d5a3d', '#b45309', '#1e40af', '#7c2d12', '#166534', '#9a3412', '#a16207'][loop.index0 % 7] }}"></span>
            {{ item.title[:20] }}{% if item.title|length > 20 %}...{% endif %}
        </span>
        {% endfor %}
    </div>
</div>

<!-- Calendar -->
<div id="calendar"></div>

<!-- Booking Details Modal -->
<div id="bookingModal" class="fixed inset-0 z-50 modal-overlay hidden items-center justify-center p-4" style="background: rgba(0,0,0,0.55); backdrop-filter: blur(4px);">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 relative shadow-2xl">
        <button onclick="closeBookingModal()" class="absolute top-3 right-4 text-2xl text-gray-400 hover:text-black">&times;</button>
        <h3 class="text-xl font-bold mb-4">📋 Booking Details</h3>
        <div id="bookingDetails" class="space-y-1 text-sm"></div>
    </div>
</div>
{% endblock %}

{% block extra_scripts %}
<script>
let calendar;

document.addEventListener('DOMContentLoaded', function() {
    const calendarEl = document.getElementById('calendar');
    
    calendar = new FullCalendar.Calendar(calendarEl, {
        initialView: 'dayGridMonth',
        headerToolbar: {
            left: 'prev,next today',
            center: 'title',
            right: 'dayGridMonth,dayGridWeek,listMonth'
        },
        height: 'auto',
        events: '/api/vendor/calendar',
        eventClick: function(info) {
            showBookingDetails(info.event);
        },
        eventMouseEnter: function(info) {
            info.el.style.transform = 'scale(1.02)';
            info.el.style.transition = 'transform 0.15s';
        },
        eventMouseLeave: function(info) {
            info.el.style.transform = 'scale(1)';
        },
        loading: function(isLoading) {
            if (isLoading) {
                console.log('Loading events...');
            }
        }
    });
    
    calendar.render();
});

function filterCalendar() {
    const itemId = document.getElementById('itemFilter').value;
    calendar.removeAllEvents();
    
    fetch(`/api/vendor/calendar?item_id=${itemId}`)
        .then(res => res.json())
        .then(events => {
            events.forEach(event => calendar.addEvent(event));
        })
        .catch(err => console.error('Error loading events:', err));
}

function changeView() {
    const view = document.getElementById('viewSelect').value;
    calendar.changeView(view);
}

function refreshCalendar() {
    calendar.refetchEvents();
    showToast('Calendar refreshed!', 'success');
}

function showBookingDetails(event) {
    const props = event.extendedProps;
    const details = document.getElementById('bookingDetails');
    
    details.innerHTML = `
        <div class="booking-detail">
            <span class="text-xs text-gray-500">Reference</span>
            <p class="font-mono font-bold">${props.reference}</p>
        </div>
        <div class="booking-detail">
            <span class="text-xs text-gray-500">Item</span>
            <p class="font-bold">${props.item}</p>
        </div>
        <div class="booking-detail">
            <span class="text-xs text-gray-500">Customer</span>
            <p class="font-bold">${props.customer}</p>
            <p class="text-xs text-gray-600">📞 ${props.customer_mobile}</p>
        </div>
        <div class="booking-detail">
            <span class="text-xs text-gray-500">Quantity</span>
            <p class="font-bold">${props.quantity} unit(s)</p>
        </div>
        <div class="booking-detail">
            <span class="text-xs text-gray-500">Dates</span>
            <p class="font-bold">${event.start.toLocaleDateString('en-IN')} → ${new Date(event.end - 1).toLocaleDateString('en-IN')}</p>
            <p class="text-xs text-gray-600">Time: ${props.start_time} - ${props.end_time}</p>
        </div>
        <div class="booking-detail">
            <span class="text-xs text-gray-500">Venue</span>
            <p class="font-bold">${props.venue}</p>
        </div>
        <div class="booking-detail">
            <span class="text-xs text-gray-500">UTR</span>
            <p class="font-mono text-green-700 font-bold">${props.utr}</p>
        </div>
        <div class="booking-detail">
            <span class="text-xs text-gray-500">Earnings</span>
            <p class="font-bold text-green-700">₹${props.base_rent}</p>
            <p class="text-xs text-gray-600">Total: ₹${props.total}</p>
        </div>
        <div class="booking-detail">
            <span class="text-xs text-gray-500">Status</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-bold
                ${props.status === 'confirmed' ? 'bg-green-100 text-green-800' : 
                  props.status === 'cancelled' ? 'bg-red-100 text-red-800' : 
                  props.status === 'completed' ? 'bg-blue-100 text-blue-800' : 
                  'bg-gray-100 text-gray-800'}">
                ${props.status.charAt(0).toUpperCase() + props.status.slice(1)}
            </span>
        </div>
    `;
    
    document.getElementById('bookingModal').classList.remove('hidden');
    document.getElementById('bookingModal').classList.add('flex');
}

function closeBookingModal() {
    document.getElementById('bookingModal').classList.add('hidden');
    document.getElementById('bookingModal').classList.remove('flex');
}
</script>
{% endblock %}